# Скопируйте в .env и заполните вручную. Сам .env в git не коммитится.
# Значения — в личном кабинете хакатона, вкладка «Виртуальная машина» → «LLM для команды».
# На ВМ эти переменные уже заданы в окружении, .env там не нужен.
OPENAI_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
OPENAI_API_KEY=
# Предохранитель: live-вызовы отключаются, когда расход за сутки достигает этой суммы (лимит команды 100 ₽ общий для ноутбука и ВМ)
LLM_DAILY_BUDGET_RUB=90
