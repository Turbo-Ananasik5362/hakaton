# Настройки сервера «Каркас». Скопируйте файл под именем .env в корень проекта и заполните нужное.
# Переменные окружения важнее значений из файла. Без этого файла сервер тоже запускается (режим mock).
# Сам файл с ключами не коммитится (.gitignore).

# --- Шлюз LLM (OpenAI-совместимый API с моделями GigaChat) ------------------------------------------------
# Адрес шлюза без завершающего «/chat/completions». Выдают организаторы, например https://<шлюз>/api/v1/llm/v1
OPENAI_BASE_URL=
# Ключ доступа к шлюзу. Никогда не коммитьте его и не вставляйте в чаты.
OPENAI_API_KEY=

# --- Режим работы с моделью --------------------------------------------------------------------------------
# auto   — live, если заданы OPENAI_BASE_URL и OPENAI_API_KEY, иначе mock (по умолчанию);
# live   — только настоящий шлюз (без ключей вызовы завершаются ошибкой);
# mock   — заготовленные ответы из tests/fixtures/llm, без сети и без расходов;
# replay — только ответы из кеша cache/llm/ (промах кеша — ошибка), без расходов.
LLM_MODE=auto

# Модель по умолчанию для генерации (каркас и содержание).
LLM_DEFAULT_MODEL=GigaChat/GigaChat-3-Pro

# Предохранитель: сколько рублей в сутки (по МСК) можно потратить на живые вызовы; дальше они отклоняются.
# Расход считается по logs/llm_cost.jsonl этой машины.
LLM_DAILY_BUDGET_RUB=90

# Сколько вызовов модели идёт одновременно (шлюз ограничивает параллельные запросы на команду).
LLM_CONCURRENCY=2

# Минимальный таймаут одного вызова, секунды (для длинных ответов он увеличивается автоматически).
LLM_TIMEOUT_S=120

# Повторы при сбое сети или сервера (5xx). При ответе 429 клиент ждёт дольше и пробует больше раз.
LLM_MAX_RETRIES=4

# 1 — просить у шлюза ответ строго по JSON-схеме; 0 — сразу инструкция «верни JSON» с проверкой и ремонтом.
LLM_SCHEMA_STRICT=1

# --- Надёжность и нагрузка ---------------------------------------------------------------------------------
# Сколько секунд даётся на генерацию комплекта одной сессии; дальше вызовы модели пропускаются, комплект
# собирается из готового.
GENERATION_DEADLINE_S=1500

# Новых сессий в минуту с одного адреса (сверх — ответ 429 с Retry-After).
RATE_LIMIT_PER_MINUTE=30

# Сессий в работе одновременно (идут и ждут в очереди генерации); сверх — ответ 429.
MAX_ACTIVE_SESSIONS=20
