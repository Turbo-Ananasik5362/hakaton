# Что не отправляется в контекст сборки образа (Dockerfile копирует только app/, data/ и tests/fixtures/llm).

# Скрытые папки и файлы в корне: .git, окружение, кеши, настройки редакторов и локальных инструментов.
# «.?*» — точка и хотя бы один символ: сам корень контекста «.» правило не задевает.
.?*
.venv
.cache
.tmp
.env
.env.*

# Данные, которые создаёт работающий сервер (в контейнере — тома из docker-compose.yml), и результаты прогонов
cache
logs
data/sessions
eval/runs

# Документация серверу не нужна
docs
*.md

# Мусор сборки Python и macOS
**/__pycache__
**/*.pyc
**/.DS_Store
